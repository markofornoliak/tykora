{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "isolatedModules": true, "resolveJsonModule": true, "esModuleInterop": true,
    "noFallthroughCasesInSwitch": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "node", "vitest/globals"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts"]
}
