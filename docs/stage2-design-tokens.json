{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "project": "TYKORA",
  "version": "1.0-stage2",
  "description": "Stage 2 design decisions. All values and sample data are demonstrative.",
  "typography": {
    "ui": {
      "$value": "-apple-system, BlinkMacSystemFont, Segoe UI, Arial, sans-serif"
    },
    "typing": {
      "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "scalePx": {
      "xs": 11,
      "sm": 12,
      "body": 14,
      "lead": 16,
      "h3": 17,
      "h2": 23,
      "h1Desktop": 58,
      "h1Mobile": 37,
      "typingDesktop": 37,
      "typingMobile": 25
    },
    "tracking": {
      "display": "-0.055em",
      "label": "0.12em"
    }
  },
  "spacing": {
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "8": {
      "$value": "32px"
    },
    "10": {
      "$value": "40px"
    },
    "12": {
      "$value": "48px"
    },
    "16": {
      "$value": "64px"
    }
  },
  "radiusPx": {
    "control": 11,
    "card": 18,
    "pill": 999,
    "key": 7
  },
  "motion": {
    "microMs": 120,
    "uiMs": 180,
    "screenMs": 220,
    "easing": "cubic-bezier(.18,.8,.25,1)",
    "reducedMotion": "all nonessential animation disabled"
  },
  "layout": {
    "sidebarPx": 244,
    "mobileNavBreakpointPx": 820,
    "compactBreakpointPx": 520,
    "touchTargetRecommendedPx": 44
  },
